<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FCF9F5" />
      <stop offset="60%" stop-color="#F6EDE2" />
      <stop offset="100%" stop-color="#EFE2D2" />
    </linearGradient>

    <!-- Gold Metallic Gradient -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C59B27" />
      <stop offset="35%" stop-color="#E8C868" />
      <stop offset="70%" stop-color="#D4AF37" />
      <stop offset="100%" stop-color="#A67C1E" />
    </linearGradient>

    <!-- Crimson Gradient -->
    <linearGradient id="crimsonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#801426" />
      <stop offset="100%" stop-color="#9B1B30" />
    </linearGradient>

    <!-- Subtle Pattern Fill -->
    <pattern id="motifPattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M20 0 L40 20 L20 40 L0 20 Z" fill="none" stroke="#D4AF37" stroke-width="0.75" stroke-opacity="0.12" />
      <circle cx="20" cy="20" r="1.5" fill="#D4AF37" fill-opacity="0.15" />
    </pattern>
  </defs>

  <!-- Background Base -->
  <rect width="600" height="800" fill="url(#bgGrad)" />

  <!-- Background Subtle Heritage Lattice -->
  <rect width="600" height="800" fill="url(#motifPattern)" />

  <!-- Outer Elegant Border -->
  <rect x="24" y="24" width="552" height="752" rx="12" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" stroke-opacity="0.45" />

  <!-- Inner Delicate Inset Frame -->
  <rect x="36" y="36" width="528" height="728" rx="8" fill="none" stroke="#9B1B30" stroke-width="0.8" stroke-opacity="0.25" stroke-dasharray="4,3" />

  <!-- Four Regal Corner Filigree Motifs -->
  <!-- Top Left -->
  <g transform="translate(36, 36)">
    <path d="M0,24 Q16,16 24,0" fill="none" stroke="url(#goldGrad)" stroke-width="2" />
    <circle cx="12" cy="12" r="2.5" fill="#9B1B30" />
  </g>
  <!-- Top Right -->
  <g transform="translate(564, 36) scale(-1, 1)">
    <path d="M0,24 Q16,16 24,0" fill="none" stroke="url(#goldGrad)" stroke-width="2" />
    <circle cx="12" cy="12" r="2.5" fill="#9B1B30" />
  </g>
  <!-- Bottom Left -->
  <g transform="translate(36, 764) scale(1, -1)">
    <path d="M0,24 Q16,16 24,0" fill="none" stroke="url(#goldGrad)" stroke-width="2" />
    <circle cx="12" cy="12" r="2.5" fill="#9B1B30" />
  </g>
  <!-- Bottom Right -->
  <g transform="translate(564, 764) scale(-1, -1)">
    <path d="M0,24 Q16,16 24,0" fill="none" stroke="url(#goldGrad)" stroke-width="2" />
    <circle cx="12" cy="12" r="2.5" fill="#9B1B30" />
  </g>

  <!-- Center Artwork & Emblem -->
  <g transform="translate(300, 340)">
    <!-- Soft Glow Behind Medallion -->
    <circle cx="0" cy="0" r="95" fill="#FFFFFF" fill-opacity="0.6" filter="blur(10px)" />

    <!-- Medallion Outlines (Arch / Jharokha motif) -->
    <circle cx="0" cy="0" r="82" fill="none" stroke="url(#goldGrad)" stroke-width="2" stroke-opacity="0.8" />
    <circle cx="0" cy="0" r="76" fill="#FFFDF9" stroke="#9B1B30" stroke-width="1" stroke-opacity="0.3" />

    <!-- Decorative Dots on Ring -->
    <g fill="url(#goldGrad)">
      <circle cx="0" cy="-76" r="2" />
      <circle cx="0" cy="76" r="2" />
      <circle cx="-76" cy="0" r="2" />
      <circle cx="76" cy="0" r="2" />
      <circle cx="-54" cy="-54" r="1.5" />
      <circle cx="54" cy="-54" r="1.5" />
      <circle cx="-54" cy="54" r="1.5" />
      <circle cx="54" cy="54" r="1.5" />
    </g>

    <!-- Stylized Heritage Garment / Paisley Motif inside medallion -->
    <g transform="translate(0, -5) scale(0.95)">
      <!-- Royal Crown / Crest Finial -->
      <path d="M-8,-42 C-4,-48 0,-52 0,-54 C0,-52 4,-48 8,-42 C4,-40 -4,-40 -8,-42 Z" fill="url(#goldGrad)" />
      
      <!-- Hanger / Garment Shoulder Arc -->
      <path d="M0,-36 C-18,-36 -28,-24 -36,-14 C-38,-11 -34,-8 -30,-8 C-18,-14 -8,-16 0,-16 C8,-16 18,-14 30,-8 C34,-8 38,-11 36,-14 C28,-24 18,-36 0,-36 Z" fill="url(#crimsonGrad)" opacity="0.9" />

      <!-- Ethnic Kurti / Sherwani Body Silhouette with Lotus Flourish -->
      <path d="M-22,-8 C-24,12 -30,36 -32,48 C-20,44 20,44 32,48 C30,36 24,12 22,-8 C12,-11 -12,-11 -22,-8 Z" fill="#FBF6EE" stroke="url(#goldGrad)" stroke-width="1.5" />

      <!-- Delicate Zari Placket / Buti -->
      <line x1="0" y1="-8" x2="0" y2="38" stroke="url(#goldGrad)" stroke-width="1.8" stroke-dasharray="3,2" />
      <circle cx="0" cy="2" r="2" fill="#9B1B30" />
      <circle cx="0" cy="14" r="2" fill="#9B1B30" />
      <circle cx="0" cy="26" r="2" fill="#9B1B30" />

      <!-- Lotus Petals at hem -->
      <path d="M-12,38 Q0,46 12,38 Q0,34 -12,38 Z" fill="url(#goldGrad)" opacity="0.7" />
    </g>
  </g>

  <!-- Typography Section -->
  <g transform="translate(300, 480)" text-anchor="middle">
    <!-- Brand Title -->
    <text y="0" font-family="'Cormorant Garamond', Georgia, serif" font-size="28" font-weight="700" letter-spacing="6" fill="#2C1810">
      RAJKANWARI
    </text>

    <!-- Gold Divider with Star Accent -->
    <g transform="translate(0, 16)">
      <line x1="-80" y1="0" x2="-18" y2="0" stroke="url(#goldGrad)" stroke-width="1" />
      <polygon points="0,-4 3,0 0,4 -3,0" fill="url(#crimsonGrad)" />
      <line x1="18" y1="0" x2="80" y2="0" stroke="url(#goldGrad)" stroke-width="1" />
    </g>

    <!-- Tagline -->
    <text y="36" font-family="'Cormorant Garamond', Georgia, serif" font-size="16" font-style="italic" letter-spacing="2" fill="#9B1B30">
      Curated Style
    </text>

    <!-- Image Status Notice Badge -->
    <g transform="translate(0, 72)">
      <rect x="-85" y="-14" width="170" height="28" rx="14" fill="#FFFFFF" stroke="#E8D4A0" stroke-width="1" opacity="0.9" />
      <text y="4" font-family="'Inter', -apple-system, sans-serif" font-size="10.5" font-weight="600" letter-spacing="1.5" fill="#7A6A5F">
        IMAGE COMING SOON
      </text>
    </g>
  </g>

  <!-- Bottom Brand Watermark Line -->
  <text x="300" y="744" text-anchor="middle" font-family="'Inter', -apple-system, sans-serif" font-size="9.5" letter-spacing="1" fill="#A8998C">
    HANDCRAFTED HERITAGE LUXURY
  </text>
</svg>
